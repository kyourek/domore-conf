<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Authors>Ken Yourek</Authors>
    <Copyright>Copyright © Ken Yourek 2023-2026</Copyright>
    <RootNamespace>Domore</RootNamespace>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>14.0</LangVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <PackageProjectUrl>https://github.com/kyourek/domore-conf</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/kyourek/domore-conf.git</RepositoryUrl>
    <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>